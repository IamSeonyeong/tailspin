---
import type { Category, Publisher } from '../types/game';

/** Props for the category/publisher filter form. */
interface Props {
    /** Categories offered as multi-select checkboxes. */
    categories: Category[];
    /** Publishers offered in the single-select dropdown. */
    publishers: Publisher[];
    /** Total number of games, used for the initial result count. */
    total: number;
}

const { categories, publishers, total } = Astro.props;
const focusRing = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    class="mb-6 bg-slate-800/60 rounded-xl border border-slate-700/50 p-4 space-y-4"
    aria-label="Filter games"
    data-testid="game-filters"
    data-game-filters
>
    <fieldset class="min-w-0">
        <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-700/50 px-3 py-1 text-sm text-slate-200 cursor-pointer hover:border-blue-500/50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-600/20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    <span>{category.name}</span>
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="filter-publisher" class="block text-sm font-medium text-slate-300 mb-2">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class={`rounded-lg bg-slate-700 border border-slate-600 text-slate-100 px-3 py-2 text-sm ${focusRing}`}
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
        </div>
        <button
            type="button"
            class={`rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 px-4 py-2 text-sm transition-colors ${focusRing}`}
            data-testid="filter-clear"
            data-filter-clear
        >
            Clear filters
        </button>
    </div>

    <p
        class="text-sm text-slate-400"
        role="status"
        aria-live="polite"
        data-testid="filter-result-count"
        data-filter-count
        data-total={total}
    >
        Showing {total} of {total} games
    </p>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-game-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
    const counter = form?.querySelector<HTMLElement>('[data-filter-count]');
    const clearButton = form?.querySelector<HTMLButtonElement>('[data-filter-clear]');
    const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const checkboxes = Array.from(
        form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? [],
    );

    /**
     * Shows only the cards matching the selected categories (OR) and publisher (AND),
     * then updates the result count, the empty state, and the URL query string.
     */
    function applyFilters(): void {
        const selectedCategories = checkboxes.filter((c) => c.checked).map((c) => c.value);
        const publisher = publisherSelect?.value ?? '';
        let visible = 0;
        for (const card of cards) {
            const matches =
                (selectedCategories.length === 0 ||
                    selectedCategories.includes(card.dataset.categoryId ?? '')) &&
                (publisher === '' || card.dataset.publisherId === publisher);
            card.hidden = !matches;
            if (matches) visible++;
        }
        if (counter) counter.textContent = `Showing ${visible} of ${cards.length} games`;
        if (emptyState) emptyState.hidden = visible !== 0;

        const params = new URLSearchParams();
        selectedCategories.forEach((id) => params.append('category', id));
        if (publisher) params.set('publisher', publisher);
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    if (form) {
        const params = new URLSearchParams(location.search);
        const initial = params.getAll('category');
        checkboxes.forEach((c) => (c.checked = initial.includes(c.value)));
        const initialPublisher = params.get('publisher') ?? '';
        if (publisherSelect && [...publisherSelect.options].some((o) => o.value === initialPublisher)) {
            publisherSelect.value = initialPublisher;
        }

        form.addEventListener('change', applyFilters);
        form.addEventListener('submit', (event) => event.preventDefault());
        clearButton?.addEventListener('click', () => {
            form.reset();
            applyFilters();
        });
        applyFilters();
    }
</script>
